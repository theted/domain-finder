# Without a key the app runs in demo mode: canned names, real availability checks.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# PORT=5000
# HOST=127.0.0.1
# SEARCHES_PER_HOUR=30
# How many proxies in front of the app to trust X-Forwarded-For from, so the rate limit sees
# real client IPs. docker-compose.yml sets 1 (the host nginx); leave unset when nothing proxies.
# TRUST_PROXY=1
